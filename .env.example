# Required: your Claude API key (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model and effort for the Game Master
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Optional: if set, players must enter this code to join (protects your API bill)
ACCESS_CODE=

# Optional: maximum simultaneous adventures (default 10)
MAX_ACTIVE_GAMES=10

# Optional: set to 1 to use a fake GM (no API calls) for local testing
MOCK_GM=
